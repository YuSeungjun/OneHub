{
  "name": "onehub",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:backend": "pyinstaller --noconfirm --distpath ./backend/dist main.spec",
    "build": "vite build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.onehub.app",
    "productName": "OneHub",
    "directories": {
      "output": "installer"
    },
    "asar": true,
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "package.json",
      "!node_modules/**"
    ],
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "logo/logo.ico"
    },
    "nsis": {
      "artifactName": "OneHub_Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OneHub",
      "installerIcon": "logo/logo.ico",
      "uninstallerIcon": "logo/logo.ico",
      "installerHeaderIcon": "logo/logo.ico",
      "installerSidebar": null,
      "language": "1042",
      "displayLanguageSelector": false
    },
    "mac": {
      "target": "dmg"
    },
    "extraResources": [
      {
        "from": "backend/dist/main.exe",
        "to": "backend/main.exe",
        "filter": ["**/*"]
      },
      {
        "from": "renderer",
        "to": "renderer",
        "filter": ["**/*", "!**/*.map"]
      }
    ]
  },
  "dependencies": {
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  }
}