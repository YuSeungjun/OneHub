{
  "name": "onehub",
  "private": true,
  "version": "0.1.1",
  "description": "OneHub YouTube video and audio downloader",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:backend": "uv run --frozen pyinstaller --noconfirm --distpath ./backend/dist main.spec",
    "build:renderer": "vite build",
    "build:runtime": "node scripts/prepare-runtime.cjs",
    "build": "npm run build:backend && npm run build:runtime && npm run build:renderer && electron-builder",
    "test:backend": "uv run --frozen pytest backend/tests -q",
    "test:electron": "node --test electron/tests/*.test.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.onehub.app",
    "productName": "OneHub",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "installer"
    },
    "asar": true,
    "files": [
      "electron/*.js",
      "package.json",
      "!node_modules/**"
    ],
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "logo/logo.ico",
      "extraResources": [
        {
          "from": "backend/dist/onehub_backend",
          "to": "backend"
        }
      ]
    },
    "nsis": {
      "artifactName": "OneHub_Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OneHub",
      "installerIcon": "logo/logo.ico",
      "uninstallerIcon": "logo/logo.ico",
      "installerHeaderIcon": "logo/logo.ico",
      "installerSidebar": null,
      "language": "1042",
      "displayLanguageSelector": false
    },
    "mac": {
      "target": "dmg",
      "icon": "logo/logo.png",
      "category": "public.app-category.utilities",
      "extraResources": [
        {
          "from": "backend/dist/onehub_backend",
          "to": "backend"
        }
      ]
    },
    "dmg": {
      "artifactName": "OneHub_Setup.dmg",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime"
      },
      {
        "from": "renderer",
        "to": "renderer",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ]
  },
  "dependencies": {
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  }
}
